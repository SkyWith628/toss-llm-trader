# 실제 키는 .env 에 넣고 절대 Git 커밋하지 말 것 (.gitignore에 .env 포함)
# --- 다음 단계에서 사용 ---
ANTHROPIC_API_KEY=sk-ant-...          # LLM 에이전트용
TOSS_APP_KEY=...                      # 토스증권 Open API client_id (설정>Open API에서 발급)
TOSS_SECRET_KEY=...                   # client_secret
TOSS_ACCOUNT_NO=...                   # 주문/잔고 조회에 쓰는 계좌번호
TRADING_MODE=paper                    # paper | live  (기본 paper=dry-run, 실주문은 live일 때만)
