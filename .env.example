# 이 파일을 복사해 `.env`로 만들고 값을 채우세요:  cp .env.example .env
# .env는 .gitignore에 있어 커밋되지 않습니다. 키를 코드/깃/채팅에 절대 올리지 마세요.

# ── 토스증권 Open API (단계 2 실거래 브로커) ──
TOSS_APP_KEY=            # 발급받은 client_id
TOSS_SECRET_KEY=         # 발급받은 client_secret
# TOSS_ACCOUNT_NO = API가 주는 accountSeq 값. 손으로 찾지 말고 아래로 자동 탐색:
#   python3 scripts/verify_toss_connection.py   → 출력된 accountSeq를 여기에 붙여넣기
TOSS_ACCOUNT_NO=

# 실주문 안전 스위치. 기본 paper(=dry-run, 실주문 미전송).
# live 로 바꾸는 순간부터 진짜 주문이 나갑니다 — 페이퍼 검증 통과 후 본인이 명시적으로만.
TRADING_MODE=paper

# ── Claude (LLM 에이전트 전략) ──
ANTHROPIC_API_KEY=
